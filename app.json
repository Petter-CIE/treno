{
  "expo": {
    "name": "Varde Fitness",
    "slug": "varde-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.cie.varde",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D171E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "no.cie.varde"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#3FD6B0"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D171E"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.536542645818-hfefk8vbkhnkapcksc2c6lcqmocduk83"
        }
      ]
    ],
    "scheme": "varde",
    "backgroundColor": "#0D171E",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "cie-as",
    "extra": {
      "eas": {
        "projectId": "71c34094-d081-450f-befd-a171e2d95bd5"
      }
    }
  }
}
